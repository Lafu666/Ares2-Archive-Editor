<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 导出方式：development / ad-hoc / app-store / enterprise -->
	<!-- development: 开发设备调试 -->
	<!-- ad-hoc:      Ad-Hoc 分发（指定设备 UDID） -->
	<!-- app-store:   App Store 发布 -->
	<!-- enterprise:  企业内部分发 -->
	<key>method</key>
	<string>development</string>

	<!-- 开发者团队 ID（占位符，请替换为你的 Apple Developer Team ID） -->
	<!-- 获取方式：https://developer.apple.com/account → Membership Details → Team ID -->
	<key>teamID</key>
	<string>YOUR_TEAM_ID</string>

	<!-- 签名风格：manual 表示手动指定描述文件 -->
	<key>signingStyle</key>
	<string>manual</string>

	<!-- 手动指定各 Bundle ID 对应的描述文件 -->
	<key>provisioningProfiles</key>
	<dict>
		<key>com.ares.toolbox</key>
		<dict>
			<!-- 描述文件的 UUID（可在 .mobileprovision 中查看） -->
			<key>UUID</key>
			<string>YOUR_PROVISIONING_PROFILE_UUID</string>
			<!-- 描述文件名称 -->
			<key>name</key>
			<string>YOUR_PROVISIONING_PROFILE_NAME</string>
		</dict>
	</dict>

	<!-- 是否剥离 Swift 符号（减小包体积） -->
	<key>stripSwiftSymbols</key>
	<true/>

	<!-- 是否编译 Bitcode（iOS 17 已废弃，设为 NO） -->
	<key>compileBitcode</key>
	<false/>

	<!-- 是否上传符号文件到 Apple -->
	<key>uploadSymbols</key>
	<false/>

	<!-- 是否在 IPA 中包含 iCloud 容器环境配置 -->
	<key>iCloudContainerEnvironment</key>
	<string>Development</string>
</dict>
</plist>
