# XcodeGen 生成的项目文件（本项目已直接包含 .xcodeproj，无需 XcodeGen）
# 如使用 XcodeGen 重新生成，可取消下方注释
# *.xcodeproj
# *.xcworkspace

# XcodeGen 生成的 Info.plist
AresToolbox/Info.plist

# 保留 project.yml 配置文件（仅供参考）
!project.yml

# build 目录（CI 与本地构建产物）
build/
DerivedData/
*.xcarchive

# IPA 打包产物
*.ipa
Payload/

# Swift Package Manager
.swiftpm/
.build/
Package.resolved
*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved

# CocoaPods（本项目未使用，保留以防后续引入）
Pods/

# Carthage（本项目未使用，保留以防后续引入）
Carthage/Build/

# fastlane（本项目未使用，保留以防后续引入）
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# macOS 系统文件
.DS_Store
.AppleDouble
.LSOverride
Icon?

# Xcode 用户数据
xcuserdata/
*.xcuserstate
*.xcuserdatad/
*.xcscmblueprint
*.xccheckout

# Xcode 打印设置（per-user）
*.moved-aside

# Playground
Playgrounds/

# 代码签名与描述文件（敏感信息，不提交）
*.mobileprovision
*.p12
*.cer
*.key
certificates/
provisioning/

# 构建日志与临时文件
*.log
*.xcactivitylog
*.playground/
*.swp
*.swo
*~

# vim
*.orig

# JetBrains IDE（AppCode 等）
.idea/
*.iml

# VSCode
.vscode/
